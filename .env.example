# Database
POSTGRES_USER=llamastream
POSTGRES_PASSWORD=llamastream_secret
POSTGRES_DB=llamastream

# Backend
APP_NAME=LlamaStream
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=7d
ALLOW_PUBLIC_REGISTRATION=false
ADMIN_EMAIL=admin@llamastream.local
ADMIN_PASSWORD=admin123456
ADMIN_USERNAME=admin
DEFAULT_AUDIO_QUALITY=high

# Storage — host paths for Docker volume mounts (default: ./storage under project root)
STORAGE_PATH=./storage
# Optional overrides (host paths). Leave empty to use STORAGE_PATH subfolders:
# POSTGRES_DATA_PATH=./storage/postgres/data
# MUSIC_DATA_PATH=./storage/music
# CACHE_DATA_PATH=./storage/cache
# AVATARS_DATA_PATH=./storage/avatars
# Backend paths when running locally without Docker (defaults to STORAGE_PATH subfolders):
# MUSIC_STORAGE_PATH=./storage/music
# CACHE_PATH=./storage/cache
# AVATAR_PATH=./storage/avatars

# ── HTTPS reverse proxy (IMPORTANT) ──
# Use your public HTTPS URL. Required when frontend and backend are on different domains.
CORS_ORIGIN=https://llamastream.apbs.link

BACKEND_PORT=3001
FRONTEND_PORT=3000

# Frontend API URL — leave EMPTY for same-domain /api proxy (recommended)
# Do NOT use http:// when your site is https:// — browsers will block it (mixed content)
VITE_API_URL=
VITE_WS_URL=
# App display name (sidebar, login, PWA). Defaults to APP_NAME when empty
VITE_APP_NAME=

# Only if API is on a separate HTTPS subdomain:
# VITE_API_URL=https://api-llamastream.apbs.link

# Spotify API — search metadata + OAuth streaming (Premium)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# OAuth callback — MUST match Spotify Developer Dashboard → Redirect URIs exactly
# Same domain as CORS_ORIGIN, path /api/auth/spotify/callback, https, no trailing slash
SPOTIFY_REDIRECT_URI=https://llamastream.apbs.link/api/auth/spotify/callback
# Where to send the user after OAuth (settings page)
FRONTEND_URL=https://llamastream.apbs.link
# ISO country code for search results (default IL for Israel)
SPOTIFY_MARKET=IL
# Note: Spotify /search accepts max limit of 10 (enforced in backend)
